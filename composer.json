{
    "name": "mycomm/mycomm-laravel",
    "description": "Laravel integration for the MyComm PHP SDK: configuration, a facade, a signed webhook route and a testing fake.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mycomm", "laravel", "sms", "messaging", "webhooks"],
    "homepage": "https://mycomm.cogneer.tech/docs",
    "authors": [
        {"name": "Cogneer", "homepage": "https://cogneer.tech"}
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "mycomm/mycomm-php": "^1.0"
    },
    "require-dev": {
        "illuminate/notifications": "^12.0 || ^13.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "MyComm\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyComm\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MyComm\\Laravel\\MyCommServiceProvider"
            ],
            "aliases": {
                "MyComm": "MyComm\\Laravel\\Facades\\MyComm"
            }
        }
    },
    "suggest": {
        "illuminate/notifications": "Send Laravel notifications as text messages with the 'mycomm' channel."
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable"
}
